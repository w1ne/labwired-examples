  "source": "#include <Arduino.h>\n#include <Wire.h>\n#include <math.h>\n\n// AXIOM H1, Rev A. 20 logical joints are mapped to two PCA9685 controllers.\n// PCA9685 OE is HIGH=disabled, LOW=enabled; both are disabled on any safety fault.\nstatic constexpr uint8_t SDA_PIN=8, SCL_PIN=9;\nstatic constexpr uint8_t OE_A=3, OE_B=4, ESTOP_PIN=10, STATUS_LED=5;\nstatic constexpr uint8_t PCA_A=0x40, PCA_B=0x41, MPU=0x68, TOF=0x29;\nstatic constexpr int NUM_JOINTS=20;\nstatic const char *const joint_name[NUM_JOINTS] = {\n  \"neck_yaw\",\"neck_pitch\",\n  \"left_shoulder_pitch\",\"left_shoulder_roll\",\"left_elbow\",\"left_wrist\",\"left_gripper\",\n  \"right_shoulder_pitch\",\"right_shoulder_roll\",\"right_elbow\",\"right_wrist\",\"right_gripper\",\n  \"left_hip_pitch\",\"left_hip_roll\",\"left_knee\",\"left_ankle\",\n  \"right_hip_pitch\",\"right_hip_roll\",\"right_knee\",\"right_ankle\"\n};\nstatic constexpr int16_t jmin[NUM_JOINTS]={-60,-25,-95,-70,-5,-70,0,-95,-80,-5,-70,0,-85,-40,-5,-35,-85,-40,-5,-35};\nstatic constexpr int16_t jmax[NUM_JOINTS]={60,30,90,80,125,70,35,90,70,125,70,35,80,40,115,35,80,40,115,35};\nstatic float joints[NUM_JOINTS]={};\nstatic uint32_t lastControl=0, lastReport=0;\nenum State { STARTUP, POSE_IDLE, WAVE, PROX_BLOCKED, TILT_BLOCKED, ESTOP_LATCHED, SENSOR_UNAVAILABLE };\nstatic State state=STARTUP;\nstatic bool latch=false;\nstatic bool pcaOK=false;\nstatic bool reportedClear=false, reportedFirstRange=false;\n\nstatic bool writeReg(uint8_t addr,uint8_t reg,uint8_t value){\n  Wire.beginTransmission(addr);Wire.write(reg);Wire.write(value);\n  return Wire.endTransmission()==0;\n}\nstatic bool readN(uint8_t addr,uint8_t reg,uint8_t *buf,size_t n){\n  Wire.beginTransmission(addr);Wire.write(reg);\n  if(Wire.endTransmission(false)!=0)return false;\n  if((size_t)Wire.requestFrom(addr,(uint8_t)n)!=n)return false;\n  for(size_t i=0;i<n;i++)buf[i]=(uint8_t)Wire.read();\n  return true;\n}\nstatic bool initPca(uint8_t addr){\n  // MODE1 sleep -> 50 Hz prescale 121, restart/autoincrement.\n  return writeReg(addr,0x00,0x10)&&writeReg(addr,0xFE,121)&&\n         writeReg(addr,0x00,0x20);\n}\nstatic bool writeAngle(int j,float a){\n  if(j<0||j>=NUM_JOINTS)return false;\n  a=fmaxf(jmin[j],fminf(jmax[j],a));\n  float fraction=(a-jmin[j])/(float)(jmax[j]-jmin[j]);\n  uint16_t width=(uint16_t)(110+390*fraction);\n  uint8_t addr=j<16?PCA_A:PCA_B;\n  uint8_t channel=(uint8_t)(j%16),reg=(uint8_t)(0x06+4*channel);\n  Wire.beginTransmission(addr);\n  Wire.write(reg);Wire.write((uint8_t)0);Wire.write((uint8_t)0);\n  Wire.write((uint8_t)(width&0xFF));Wire.write((uint8_t)(width>>8));\n  bool ok=Wire.endTransmission()==0;\n  if(ok)joints[j]=a;\n  return ok;\n}\nstatic void enableOutputs(bool enable){\n  digitalWrite(OE_A,enable?LOW:HIGH);\n  digitalWrite(OE_B,enable?LOW:HIGH);\n  digitalWrite(STATUS_LED,enable?HIGH:LOW);\n}\nstatic bool readRangeMm(uint16_t *mm){\n  uint8_t b[2];\n  if(!readN(TOF,0x1e,b,2))return false;\n  *mm=(uint16_t(b[0])<<8)|b[1];\n  return true;\n}\nstatic bool readTiltDeg(float *pitch){\n  uint8_t b[6];\n  if(!readN(MPU,0x3b,b,6))return false;\n  int16_t ax=(int16_t)((b[0]<<8)|b[1]);\n  int16_t az=(int16_t)((b[4]<<8)|b[5]);\n  *pitch=atan2f((float)ax,(float)az)*180.0f/3.14159265f;\n  return true;\n}\nstatic const char *stateName(State s){\n  switch(s){case STARTUP:return \"STARTUP\";case POSE_IDLE:return \"IDLE\";\n  case WAVE:return \"WAVE\";case PROX_BLOCKED:return \"PROX_STOP\";\n  case TILT_BLOCKED:return \"TILT_STOP\";case ESTOP_LATCHED:return \"ESTOP\";\n  default:return \"SENSOR_GAP\";}\n}\nstatic void transition(State s){\n  if(state!=s){state=s;Serial.print(\"AXIOM_STATE:\");Serial.println(stateName(s));}\n}\nvoid setup(){\n  Serial.begin(115200);\n  pinMode(OE_A,OUTPUT);pinMode(OE_B,OUTPUT);\n  pinMode(STATUS_LED,OUTPUT);pinMode(ESTOP_PIN,INPUT_PULLUP);\n  enableOutputs(false);\n  Wire.begin(SDA_PIN,SCL_PIN);\n  Wire.setClock(100000);\n  pcaOK=initPca(PCA_A)&&initPca(PCA_B);\n  bool zeroOK=true;\n  for(int j=0;j<NUM_JOINTS;j++)zeroOK=writeAngle(j,0.0f)&&zeroOK;\n  Serial.println(\"AXIOM_BOOT_OK\");\n  Serial.print(\"AXIOM_PCA_I2C:\");Serial.println((pcaOK&&zeroOK)?\"OK\":\"FAIL\");\n  if(pcaOK&&zeroOK){transition(POSE_IDLE);Serial.println(\"AXIOM_20_CHANNELS_WRITTEN\");}\n  else transition(SENSOR_UNAVAILABLE);\n}\nvoid loop(){\n  uint32_t now=millis();\n  if(now-lastControl<40)return;\n  lastControl=now;\n  bool estop=digitalRead(ESTOP_PIN)==LOW;\n  if(estop)latch=true;\n  // A real reset needs a separate physical reset + software acknowledgement.\n  if(latch){enableOutputs(false);transition(ESTOP_LATCHED);return;}\n  if(!pcaOK){enableOutputs(false);transition(SENSOR_UNAVAILABLE);return;}\n  uint16_t mm=0;float tilt=0;\n  bool rangeValid=readRangeMm(&mm);\n  bool tiltValid=readTiltDeg(&tilt);\n  if(!rangeValid||!tiltValid){\n    enableOutputs(false);transition(SENSOR_UNAVAILABLE);return;\n  }\n  if(!reportedFirstRange){Serial.print(\"AXIOM_FIRST_RANGE_MM:\");Serial.println(mm);reportedFirstRange=true;}\n  if(mm<250){enableOutputs(false);transition(PROX_BLOCKED);return;}\n  if(fabsf(tilt)>20){enableOutputs(false);transition(TILT_BLOCKED);return;}\n  if(!reportedClear){Serial.println(\"AXIOM_CLEAR_PATH\");reportedClear=true;}\n  const bool wave=(now/400)%2;\n  float phase=(now%400)/400.0f;\n  bool ok=true;\n  ok=writeAngle(0,10.0f*sinf(now*.004f))&&ok;\n  ok=writeAngle(4,wave?55.0f*sinf(3.14159265f*phase):0.0f)&&ok;\n  ok=writeAngle(2,wave?-22.0f:0.0f)&&ok;\n  if(!ok){enableOutputs(false);transition(SENSOR_UNAVAILABLE);return;}\n  enableOutputs(true);\n  transition(wave?WAVE:POSE_IDLE);\n  if(now-lastReport>=500){\n    lastReport=now;\n    Serial.print(\"AXIOM_RANGE_MM:\");Serial.println(mm);\n    Serial.print(\"AXIOM_TILT_DEG:\");Serial.println(tilt,1);\n  }\n}",
  "language": "arduino",
  "entry_path": "src/main.ino",
