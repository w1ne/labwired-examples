--- upstream/dshot.pio
+++ src/dshot.pio
@@ -78,7 +78,7 @@
 outone_tx:
     ; '1' bit: 84 cycles LOW (67%), 41 cycles HIGH (33%)
     nop                          [31]       ; 32 cycles
