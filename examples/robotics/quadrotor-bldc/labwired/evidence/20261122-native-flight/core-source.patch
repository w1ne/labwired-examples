+            * self.shaft.angular_velocity_rad_s().abs()
+            / self.params.shaft.inertia_kg_m2;
+        let step_s = if rate > 0.0 {
+            maximum_s.min(0.025 / rate)
+        } else {
+            maximum_s
+        };
+        validate_positive("dt_s", step_s)?;
+        Ok(step_s)
+    }
