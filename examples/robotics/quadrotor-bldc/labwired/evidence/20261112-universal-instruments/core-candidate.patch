+fn bldc_control_test_bus(legacy_walk: bool) -> SystemBus {
+    let mut bus = low_inertia_bldc_bus();
+    if legacy_walk {
+        let MotorRuntime::Bldc { timer, .. } = &bus.motors[0] else {
+            unreachable!();
+        };
+        let timer = *timer;
+        bus.peripherals[timer]
+            .dev
+            .as_any_mut()
+            .unwrap()
+            .downcast_mut::<crate::peripherals::timer::Timer>()
+            .unwrap()
+            .force_legacy_walk();
+    }
+    bus
+}
