+fn bldc_state(bus: &SystemBus) -> crate::physics::motor::BldcMotorSnapshot {
+    let MotorRuntime::Bldc { plant, .. } = &bus.motors[0] else {
+        panic!("BLDC fixture");
+    };
+    plant.snapshot()
+}
