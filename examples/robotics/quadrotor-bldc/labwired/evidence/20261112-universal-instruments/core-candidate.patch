+        for time in 0..3 {
+            capture.observe(ch, time, time as f64).unwrap();
+        }
+        let fast = capture.snapshot(0, 3);
+        for time in 3..5 {
+            capture.observe(ch, time, time as f64).unwrap();
+        }
