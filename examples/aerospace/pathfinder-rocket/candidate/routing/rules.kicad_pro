            "J7"
          ],
          "sources": [
            {
              "kind": "calculation",
              "reference": "https://www.qorvo.com/design-hub/design-tools/interactive/pcb-trace-power-handling-calculator",
              "rationale": "Preliminary 5 A routing basis using the IPC-2221 external-layer estimate k=0.048, DeltaT=10 C and nominal t=2 oz. Selected 1.8 mm, or 1.44 mm after -20% trace-width tolerance, gives an estimated 5.149 A. Finished copper thickness is not guaranteed by the cited capability page. A 1.9 mm via at 18 µm average plating has about 0.1074 mm² barrel section versus trace 0.1008 mm², but via heating/neckdowns and actual plating remain unverified."
            },
            {
              "kind": "assumption",
              "reference": "battery-current-review.json",
              "rationale": "5 A is a preliminary routing allowance, not a measured maximum. At 4.35 V, 1.5 ohm plus 1 A/5 V at assumed 75% converter efficiency already gives 4.433 A before tolerances and auxiliaries. Peak camera current and all thermal limits remain hardware gates."
            }
          ]
        },
        {
          "name": "BENCH_LOAD_SWITCHED_RETURN",
          "track_width_mm": 1,
          "clearance_mm": 0.2,
          "via_diameter_mm": 2.1,
          "via_drill_mm": 1.5,
          "nets": [
            "N$11"
          ],
          "parts": [
            "J2"
          ],
          "sources": [
            {
              "kind": "calculation",
              "reference": "https://www.qorvo.com/design-hub/design-tools/interactive/pcb-trace-power-handling-calculator",
              "rationale": "2.90 A at 2 oz and 10 C rise requires about 0.652 mm by the external IPC-2221 estimate. Selected 1.0 mm, or 0.8 mm after -20% width tolerance. The load remains external and the 1000 ms pulse unchanged; no initiator or flight qualification."
            }
          ]
        },
        {
          "name": "FIVE_VOLT_AUXILIARY",
