(version 1)
# Agent-selected geometry, not SI/PDN or fabrication qualification.
(rule "Default_track_0" (condition "A.NetName == '3V3'")
  (constraint track_width (min 0.25mm)))
(rule "Default_via_0" (condition "A.Type == 'Via' && (A.NetName == '3V3')")
  (constraint via_diameter (min 0.6mm))
  (constraint hole_size (min 0.3mm)))
(rule "Default_track_1" (condition "A.NetName == 'GND'")
