    "correctedDriver": "PASS 18/18 under AddressSanitizer and UndefinedBehaviorSanitizer",
    "casesAdded": [
      "Documented zero reset parity independent of CONFIG0x80",
      "Unknown reserved CONFIG/CONTROL2 read bits",
      "Initial current-status parity failure",
      "Rejected sequential write is atomic and faults",
      "Changed register with unchanged stored parity",
      "Corrupt stored parity with unchanged register"
    ]
  },
