(label "GND" (at 175.26 83.82 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "290ef1cf-f445-51c7-af0b-fcc25792097f"))
(text "USB OLED carrier - rev A" (at 25.4 15.24 0) (effects (font (size 2.54 2.54)) (justify left top)) (uuid "d12ec892-111c-531a-8c95-791b92fc9746"))
(text "U1: Seeed Studio XIAO ESP32C3, SKU 113991054, mounted in J2/J3.\nUSB-C is the only power input and programming/debug port.\nLeave battery pads and VBUS unconnected. BOOT/RESET require lid removal." (at 25.4 22.86 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "4896046e-6e5a-55ec-b510-dbfc826eb7a5"))
(text "J2 mates XIAO pins 1..7 in order.\n1=D0/GPIO2   2=D1/GPIO3\n3=D2/GPIO4 (SDA)   4=D3/GPIO5 (SCL)\n5=D4/GPIO6   6=D5/GPIO7   7=D6/GPIO21" (at 78.74 38.1 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "03f3c247-e8d3-52cf-bec3-3acd83f0c6c7"))
(text "J3 mates XIAO pins 8..14 in order.\n1=D7/GPIO20   2=D8/GPIO8   3=D9/GPIO9\n4=D10/GPIO10   5=3V3   6=GND   7=VBUS\nUnused socket contacts are intentionally unconnected." (at 78.74 81.28 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c37bd959-83f3-5e0e-865c-c946fdb030bb"))
(text "DISP1: Adafruit 326, STEMMA QT revision\n100 mm Adafruit 4210 cable: pin 1 GND, 2 3V3, 3 SDA, 4 SCL.\nClose SJ3 (SA0 to GND) for address 0x3C.\nKeep factory I2C jumpers SJ1/SJ2 closed. Do not populate JP2.\nCarrier 4.7k pull-ups parallel the module 10k pull-ups (~3.20k).\nFirmware uses GPIO4/GPIO5 and 100 kHz I2C." (at 185.42 81.28 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f817833b-ffa7-5196-a0d6-30513474d6c6"))
(text "Test pads: probe after removing the lid.\nCheck 3V3 to GND before inserting U1 or the display cable.\nNo hardware measurements have been recorded for this revision." (at 96.52 116.84 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "019016a9-0fe1-5277-a54c-04986d429d1f"))
(text "Mounting: four 2.9 mm non-plated holes, M2.5 screws.\n70 x 45 x 1.6 mm, two copper layers.\nKeep copper and non-mounting components outside the 3.5 mm mounting radius." (at 25.4 157.48 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c4a8ed62-53d3-5893-86a1-784d702a0014"))
(embedded_fonts no)
